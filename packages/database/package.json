  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "drizzle-kit": "^0.20.14",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
